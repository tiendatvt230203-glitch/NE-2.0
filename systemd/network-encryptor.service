[Unit]
Description=Network Encryptor
After=network.target postgresql.service vault.service
Before=be.service
[Service]
Environment="LD_LIBRARY_PATH=/usr/bin/bin-ne/lib"
Type=simple
User=root
EnvironmentFile=/opt/SEP/be/.env
# UDP multipath per-window uses receiver-side sequence repair.
Environment="NE_BOND_REORDER=1"
Environment="NE_BOND_REORDER_US=3000"
WorkingDirectory=/usr/bin/bin-ne
ExecStart=/usr/bin/bin-ne/network-encryptor
Restart=always
RestartSec=5s
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
